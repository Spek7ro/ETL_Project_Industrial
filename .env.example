# Base de datos destino del ETL y del registro de predicciones.
# Por defecto se usa SQLite en Data/warehouse.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/maintenance

# Modelo
# HORIZON_HOURS=24           # horizonte de predicción (¿falla en las próximas N horas?)
# COST_MISSED_FAILURE=10     # coste relativo de una falla no anticipada…
# COST_FALSE_ALARM=1         # …frente a una falsa alarma (define el umbral de alarma)
# LOG_PREDICTIONS=true

# Reproducción de telemetría en el dashboard
# SIMULATION_ENABLED=true
# SIM_TICK_SECONDS=3         # segundos reales entre ciclos
# REPLAY_HOURS_PER_TICK=1    # horas de planta por ciclo
