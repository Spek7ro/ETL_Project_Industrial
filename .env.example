# Base de datos destino del ETL y del registro de predicciones.
# Por defecto se usa SQLite en Data/warehouse.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/maintenance
# DECISION_THRESHOLD=0.5
# LOG_PREDICTIONS=true
# Simulación de telemetría de la flota (dashboard)
# SIMULATION_ENABLED=true
# SIM_TICK_SECONDS=3        # segundos reales entre ciclos
# SIM_MINUTES_PER_TICK=10   # minutos de planta simulados por ciclo
# SIM_SEED=7
